# ==========================================
# Aura - Environment Configuration
# ==========================================
# Copy this file to '.env' and fill in your Firebase project credentials.
# If these variables are not present or set to demo mode, Aura automatically runs
# in Interactive Demo Mode with full local simulation & WebRTC loopback capability!

VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Optional: Force Demo Mode even if keys exist (true/false)
VITE_FORCE_DEMO_MODE=false
